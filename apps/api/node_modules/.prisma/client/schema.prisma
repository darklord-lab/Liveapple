// Classora Multi-Tenant Database Schema
// Provider: SQLite for instant, zero-friction local persistence
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Institute {
  id          String      @id @default(cuid())
  name        String
  subdomain   String      @unique
  logoUrl     String?
  createdAt   DateTime    @default(now())
  users       User[]
  courses     Course[]
  batches     Batch[]
  liveClasses LiveClass[]
}

model User {
  id          String    @id @default(cuid())
  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id])
  name        String
  email       String    @unique
  phone       String?
  role        String // "ADMIN", "TEACHER", "STUDENT"
  avatarUrl   String?
  status      String    @default("active")
  createdAt   DateTime  @default(now())

  taughtBatches Batch[]           @relation("TeacherBatches")
  taughtClasses LiveClass[]       @relation("TeacherClasses")
  enrollments   BatchEnrollment[]
}

model Course {
  id          String    @id @default(cuid())
  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id])
  name        String
  category    String
  duration    String
  batches     Batch[]
}

model Batch {
  id          String            @id @default(cuid())
  instituteId String
  institute   Institute         @relation(fields: [instituteId], references: [id])
  courseId    String
  course      Course            @relation(fields: [courseId], references: [id])
  name        String
  teacherId   String?
  teacher     User?             @relation("TeacherBatches", fields: [teacherId], references: [id])
  startDate   String
  endDate     String
  enrollments BatchEnrollment[]
  liveClasses LiveClass[]
}

model BatchEnrollment {
  id         String   @id @default(cuid())
  batchId    String
  batch      Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rollNumber String?
  enrolledAt DateTime @default(now())

  @@unique([batchId, studentId])
}

model LiveClass {
  id           String    @id @default(cuid())
  instituteId  String
  institute    Institute @relation(fields: [instituteId], references: [id])
  batchId      String
  batch        Batch     @relation(fields: [batchId], references: [id])
  teacherId    String
  teacher      User      @relation("TeacherClasses", fields: [teacherId], references: [id])
  title        String
  subject      String
  chapter      String?
  roomId       String    @unique
  status       String    @default("SCHEDULED") // "SCHEDULED", "LIVE", "COMPLETED"
  scheduledAt  DateTime
  startedAt    DateTime?
  endedAt      DateTime?
  recordingUrl String?
  createdAt    DateTime  @default(now())
}

model BoardPage {
  id           String   @id @default(cuid())
  roomId       String
  pageIndex    Int
  elementsJson String // JSON stringified elements
  updatedAt    DateTime @updatedAt

  @@unique([roomId, pageIndex])
}

model ChatMessage {
  id         String   @id @default(cuid())
  roomId     String
  senderName String
  role       String
  message    String
  timestamp  DateTime @default(now())
}
