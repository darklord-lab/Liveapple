# ==============================================================================
# CLASSORA 2.0 API — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# NOTICE: This file contains ONLY placeholders and local development defaults.
# Real credentials and secrets must NEVER be committed to version control.
# In production (Render, VPS), configure these in your hosting environment dashboard.
# ==============================================================================

# Server Runtime
PORT=4000
NODE_ENV=development

# Database Configuration (SQLite local file)
DATABASE_URL="file:./dev.db"

# Security & JWT Secrets (CRITICAL: In production, generate random 64-char strings)
JWT_ACCESS_SECRET="generate_random_secret_for_production_access_tokens"
JWT_REFRESH_SECRET="generate_random_secret_for_production_refresh_tokens"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30
INVITE_TOKEN_EXPIRES_HOURS=48

# CORS Allowed Origins (Comma-separated list of web origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:5173

# LiveKit SFU Configuration
# WARNING: In production (NODE_ENV=production):
# 1. LIVEKIT_URL must start with wss:// (e.g. wss://your-project.livekit.cloud)
# 2. Localhost, 127.0.0.1, or default keys ('devkey', 'secret') are strictly rejected.
# Local development only defaults:
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Payment Gateway (Optional / Stubs)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# Public Deployed URL (Used for Render keep-alive self-ping)
APP_URL=https://liveapple.onrender.com
