# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (SQLite)
DATABASE_URL="file:./dev.db"

# Security & JWT Secrets (Change these in production!)
JWT_ACCESS_SECRET=classora_super_secret_access_jwt_key_2026_change_in_prod
JWT_REFRESH_SECRET=classora_super_secret_refresh_jwt_key_2026_change_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30
INVITE_TOKEN_EXPIRES_HOURS=48

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:5173

# LiveKit SFU (Dev Server)
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
